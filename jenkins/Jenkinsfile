pipeline {
    agent any
    tools {
        maven 'maven-3.8'
    }
    environment {
        AWS_ACCESS_KEY_ID     = credentials('jenkins_aws_access_key_id')
        AWS_SECRET_ACCESS_KEY = credentials('jenkins_aws_secret_access_key')
        DOCKER_REPO_SERVER    = '270278216475.dkr.ecr.ap-south-1.amazonaws.com'
        DOCKER_REPO           = "${DOCKER_REPO_SERVER}/java-maven-app"
        APP_NAME              = 'java-maven-app'
    }
    stages {
        stage('increment version') {
            steps {
                script {
                    echo 'incrementing app version...'
                    env.IMAGE_NAME = "v-${BUILD_NUMBER}"
                }
            }
        }
        stage('build app') {
            steps {
                script {
                    echo "building the application..."
                    sh 'mvn clean package -DskipTests'
                }
            }
        }
        stage('build and push image') {
            steps {
                script {
                    echo "building the docker image..."
                    sh "docker build -t ${DOCKER_REPO}:${IMAGE_NAME} ."
                    
                    echo "Logging into AWS ECR..."
                    sh "aws ecr get-login-password --region ap-south-1 | docker login --username AWS --password-stdin ${DOCKER_REPO_SERVER}"
                    
                    echo "Pushing image to ECR..."
                    sh "docker push ${DOCKER_REPO}:${IMAGE_NAME}"
                }
            }
        }
        stage('provision server') {
            environment {
                TF_VAR_env_prefix = 'dev'
            }
            steps {
                script {
                    dir('terraform') {
                        echo "Initializing and Applying Terraform..."
                        sh 'terraform init'
                        sh 'terraform apply --auto-approve'
                        
                        def serverIp = sh(
                            script: "terraform output -raw ec2_public_ip",
                            returnStdout: true
                        ).trim()
                        env.EC2_PUBLIC_IP = serverIp
                        echo "Target EC2 Public IP: ${env.EC2_PUBLIC_IP}"
                    }
                }
            }
        }
        stage('deploy to EC2') {
            steps {
                script {
                    def ec2Instance = "ec2-user@${env.EC2_PUBLIC_IP}"
                    def fullImage = "${DOCKER_REPO}:${IMAGE_NAME}"
                    echo "Deploying ${fullImage} to ${ec2Instance}..."

                    def ecrToken = sh(
                        script: "aws ecr get-login-password --region ap-south-1",
                        returnStdout: true
                    ).trim()

                    withCredentials([sshUserPrivateKey(credentialsId: 'ec2-server-key', keyFileVariable: 'KEY_FILE', usernameVariable: 'USER_NAME')]) {
                        echo "Waiting for EC2 SSH and Docker readiness..."
                        sh """
                            for i in {1..20}; do
                                ssh -i ${KEY_FILE} -o StrictHostKeyChecking=no -o ConnectTimeout=5 ${ec2Instance} 'docker --version' && break || sleep 10
                            done
                        """

                        echo "Copying configuration files..."
                        sh "scp -i ${KEY_FILE} -o StrictHostKeyChecking=no server-cmds.sh ${ec2Instance}:/home/ec2-user/"
                        sh "scp -i ${KEY_FILE} -o StrictHostKeyChecking=no docker-compose.yaml ${ec2Instance}:/home/ec2-user/"

                        echo "Logging into ECR on target EC2 and running application..."
                        sh """
                            ssh -i ${KEY_FILE} -o StrictHostKeyChecking=no ${ec2Instance} "
                                echo '${ecrToken}' | docker login --username AWS --password-stdin ${DOCKER_REPO_SERVER}
                                bash /home/ec2-user/server-cmds.sh ${fullImage}
                            "
                        """
                    }
                }
            }
        }
    }
}
